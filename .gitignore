# Variáveis locais (nunca sobem; o modelo é o .env.example)
.env
.env.*
!.env.example

# Segredos (nunca sobem): keystores, senhas e chaves de conta de serviço
*.jks
*.keystore
key.properties
*service-account*.json
*-firebase-adminsdk-*.json
gha-creds-*.json

# Dart / Flutter
.dart_tool/
.packages
