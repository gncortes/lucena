---
import { asset } from '../i18n';

// A posição de Lucena, a mesma da aula do app (1K1k4/1P6/8/8/8/8/r7/2R5), e a
// linha da ponte, jogada sozinha quando o tabuleiro aparece na tela.
const pieces = [
  { id: 'wK', square: 'b8' },
  { id: 'bK', square: 'd8' },
  { id: 'wP', square: 'b7' },
  { id: 'bR', square: 'a2' },
  { id: 'wR', square: 'c1' },
];
const line = 'c1d1 d8e7 d1d4 a2a1 b8c7 a1c1 c7b6 c1b1 b6c6 b1c1 c6b5 c1b1 d4b4';

const at = (square: string) =>
  `--x:${square.charCodeAt(0) - 97};--y:${8 - Number(square[1])}`;

interface Props {
  label: string;
  moves: string[];
  win: string;
}
const { label, moves, win } = Astro.props;
---

<div class="board-wrap" data-board data-line={line} data-moves={JSON.stringify(moves)} data-win={win}>
  <div class="board" role="img" aria-label={label}>
    <span class="board__hl" data-hl-from></span>
    <span class="board__hl" data-hl-to></span>
    {
      pieces.map((p) => (
        <img
          class="board__piece"
          src={asset(`pieces/${p.id}.webp`)}
          alt=""
          width="96"
          height="96"
          loading="lazy"
          decoding="async"
          data-square={p.square}
          data-start={p.square}
          style={at(p.square)}
        />
      ))
    }
  </div>
  <p class="board__move" aria-hidden="true"><span data-move>&nbsp;</span></p>
</div>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const place = (el: HTMLElement, square: string) => {
    el.style.setProperty('--x', String(square.charCodeAt(0) - 97));
    el.style.setProperty('--y', String(8 - Number(square[1])));
  };
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  for (const wrap of document.querySelectorAll<HTMLElement>('[data-board]')) {
    if (reduced) continue;
    const line = wrap.dataset.line!.split(' ');
    const moves: string[] = JSON.parse(wrap.dataset.moves!);
    const label = wrap.querySelector<HTMLElement>('[data-move]')!;
    const from = wrap.querySelector<HTMLElement>('[data-hl-from]')!;
    const to = wrap.querySelector<HTMLElement>('[data-hl-to]')!;
    const pieces = [...wrap.querySelectorAll<HTMLElement>('.board__piece')];
    let visible = false;
    let running = false;

    const reset = () => {
      for (const p of pieces) {
        p.dataset.square = p.dataset.start;
        place(p, p.dataset.start!);
      }
      from.classList.remove('is-on');
      to.classList.remove('is-on');
      label.textContent = ' ';
      wrap.classList.remove('is-won');
    };

    const run = async () => {
      running = true;
      while (visible) {
        reset();
        await wait(1400);
        for (let i = 0; i < line.length && visible; i++) {
          const a = line[i].slice(0, 2);
          const b = line[i].slice(2);
          const piece = pieces.find((p) => p.dataset.square === a)!;
          piece.dataset.square = b;
          place(piece, b);
          place(from, a);
          place(to, b);
          from.classList.add('is-on');
          to.classList.add('is-on');
          label.textContent = moves[i];
          await wait(i % 2 === 0 ? 1100 : 900);
        }
        if (!visible) break;
        label.textContent = wrap.dataset.win!;
        wrap.classList.add('is-won');
        await wait(3200);
      }
      running = false;
    };

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible && !running) run();
      },
      { threshold: 0.5 },
    ).observe(wrap);
  }
</script>
