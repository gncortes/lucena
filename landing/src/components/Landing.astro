---
import FeatureCard from './FeatureCard.astro';
import Phone from './Phone.astro';
import SiteFooter from './SiteFooter.astro';
import { asset, links, locales, pageUrl, type Locale } from '../i18n';
import { clipSize, mediaDir, stills, type Clip, type Still } from '../media';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = locales[locale].dict;
const f = t.features.items;
const shot = (still: Still) => ({
  still,
  locale,
  label: t.media[still],
  playLabel: t.media.play,
  pauseLabel: t.media.pause,
});
const phone = (clip: Clip) => ({
  clip,
  locale,
  label: t.media[clip],
  playLabel: t.media.play,
  pauseLabel: t.media.pause,
});
const dir = mediaDir(locale);
// As quatro telas do modo às cegas, em carrossel.
const blindStills = ['blindMode', 'blindBoard', 'blindSquares', 'blindNone'] as const;
const mail = (subject: string) => `mailto:${links.email}?subject=${encodeURIComponent(subject)}`;
// Ícones dos cartões sem captura (traço de 24 px, no estilo do botão de tema).
const icons = {
  voice: 'M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3M8 21h8',
} as const;
const refUrls = [links.stockfish, links.maia, links.lichess, links.firebase, links.philidor];
const opponents = [
  ['beachgoer', 'Coco', 1000],
  ['grandpa', 'Tito', 1200],
  ['snob', 'Percival', 1400],
  ['magician', 'Valdini', 1600],
  ['prodigy', 'Zuri', 1800],
  ['bodybuilder', 'Tank', 2000],
  ['foodie', 'Gino', 2200],
  ['youngster', 'Kai', 2400],
  ['master', 'Viktor', 2600],
] as const;
---

<header class="top">
  <div class="wrap top__bar">
    <a class="brand" href={pageUrl(locale)} aria-label="Lucena">
      <img src={asset('logo.webp')} alt="" width="36" height="36" />
      <span>Lucena</span>
    </a>
    <nav class="top__nav" aria-label={t.nav.menu}>
      <a href="#recursos">{t.nav.features}</a>
      <a href="#roadmap">{t.nav.roadmap}</a>
      <a href="#apoie">{t.nav.support}</a>
    </nav>
    <div class="top__tools">
      <nav class="langs" aria-label={t.nav.language}>
        {
          Object.entries(locales).map(([key, l]) => (
            <a
              href={pageUrl(key as Locale)}
              hreflang={l.hreflang}
              lang={l.hreflang}
              aria-current={key === locale ? 'page' : undefined}
              title={l.label}
            >
              {key === 'pt-br' ? 'PT' : key.toUpperCase()}
            </a>
          ))
        }
      </nav>
      <button class="theme-toggle" type="button" aria-label={t.nav.theme} data-theme-toggle>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 1.8v2.6M12 19.6v2.6M4.8 4.8l1.8 1.8M17.4 17.4l1.8 1.8M1.8 12h2.6M19.6 12h2.6M4.8 19.2l1.8-1.8M17.4 6.6l1.8-1.8"></path>
        </svg>
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1z"></path>
        </svg>
      </button>
      <a class="btn btn--small" href="#testador">{t.nav.tester}</a>
    </div>
  </div>
</header>

<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="wrap hero__grid">
      <div class="hero__text" data-hero>
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1 id="hero-title">
          {t.hero.title} <em>{t.hero.titleAccent}</em>.
        </h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="actions">
          <a class="btn" href={links.tester} rel="noopener">{t.hero.cta}</a>
          <a class="btn btn--ghost" href="#recursos">{t.hero.secondary}</a>
        </div>
        <p class="hero__note">{t.hero.note}</p>
      </div>
      <div class="hero__media" data-hero>
        <Phone {...shot('home')} class="phone--back" />
        <Phone {...phone('hero')} class="phone--hero" />
        <ul class="chips" aria-hidden="true">
          {t.hero.chips.map((chip) => <li>{chip}</li>)}
        </ul>
        <img class="hero__mascot only-light" src={asset('mascot-light.webp')} alt="" width="480" height="480" loading="lazy" />
        <img class="hero__mascot only-dark" src={asset('mascot-dark.webp')} alt="" width="480" height="480" loading="lazy" />
      </div>
    </div>
  </section>

  <div class="stats">
    <ul class="wrap stats__grid">
      {
        t.stats.map((stat) => (
          <li data-reveal>
            <strong data-count={stat.value}>{stat.value}</strong>
            <span>{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <ul>
          {t.marquee.map((name) => <li>{name}</li>)}
        </ul>
      ))}
    </div>
  </div>

  <section class="message" aria-labelledby="message-title">
    <div class="wrap message__grid">
      <div>
        <p class="kicker">{t.message.kicker}</p>
        <h2 id="message-title">{t.message.title}</h2>
        <blockquote class="quote">
          <p>{t.message.quote}</p>
          <footer>{t.message.quoteAuthor}</footer>
        </blockquote>
        {t.message.body.map((p) => <p class="body">{p}</p>)}
      </div>
      <div class="message__board" data-reveal>
        <Phone {...phone('school')} class="message__phone" />
        <p>{t.message.boardCaption}</p>
      </div>
    </div>
  </section>

  <section class="story" aria-labelledby="story-title">
    <div class="wrap">
      <article class="letter" data-reveal>
        <p class="kicker">{t.story.kicker}</p>
        <h2 id="story-title">{t.story.title}</h2>
        {t.story.paragraphs.map((p) => <p>{p}</p>)}
        <figure class="philidor">
          <img src={asset('philidor.webp')} alt={t.story.philidor.alt} width="480" height="480" loading="lazy" />
          <figcaption>{t.story.philidor.caption}</figcaption>
        </figure>
        <p>{t.story.philidor.text}</p>
        <p class="letter__sign">
          <img src={asset('logo.webp')} alt="" width="40" height="40" loading="lazy" />
          <span>{t.story.signature}</span>
        </p>
      </article>
    </div>
  </section>

  <section class="features" id="recursos" aria-labelledby="features-title">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <p class="kicker">{t.features.kicker}</p>
        <h2 id="features-title">{t.features.title}</h2>
        <p class="body">{t.features.lead}</p>
      </header>

      <article class="feature" data-reveal>
        <div class="feature__text">
          <h3>{f.progression.title}</h3>
          <p>{f.progression.body}</p>
          <ol class="opponents" aria-label={f.progression.bullets[0]} data-reveal>
            {
              opponents.map(([id, name, level]) => (
                <li>
                  <img src={asset(`opponents/${id}.webp`)} alt="" width="80" height="80" loading="lazy" />
                  <strong>{name}</strong>
                  <span>Maia {level}</span>
                </li>
              ))
            }
            <li class="opponents__top">
              <img src={asset('opponents/stockfish.webp')} alt="" width="80" height="80" loading="lazy" />
              <strong>Stockfish</strong>
              <span>{f.progression.bullets[2]}</span>
            </li>
          </ol>
          <ul class="pills">{[f.progression.bullets[1], ...f.progression.bullets.slice(3)].map((b) => <li>{b}</li>)}</ul>
        </div>
        <div class="feature__media">
          <Phone {...shot('journeyChallenge')} />
        </div>
      </article>

      <article class="feature feature--flip" data-reveal>
        <div class="feature__text">
          <h3>{f.placement.title}</h3>
          <p>{f.placement.body}</p>
          <ul class="ticks">{f.placement.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
        <div class="feature__media feature__media--pair">
          <Phone {...phone('placement')} />
          <Phone {...shot('placementResult')} />
        </div>
      </article>

      <article class="feature" data-reveal>
        <div class="feature__text">
          <h3>{f.lessons.title}</h3>
          <p>{f.lessons.body}</p>
          <p class="route__label">{t.features.route.label}</p>
          <ol class="route">
            {
              t.features.route.steps.map((step) => (
                <li>
                  <strong>{step.title}</strong>
                  <span>{step.body}</span>
                </li>
              ))
            }
          </ol>
          <ul class="ticks">{f.lessons.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
        <div class="feature__media feature__media--pair">
          <Phone {...phone('lesson')} />
          <Phone {...shot('lessonChapters')} />
        </div>
      </article>

      <div class="feature-duo">
        <article class="feature feature--card" data-reveal>
          <Phone {...shot('realGame')} />
          <div class="feature__text">
            <h3>{f.realGames.title}</h3>
            <p>{f.realGames.body}</p>
            <ul class="ticks">{f.realGames.bullets.map((b) => <li>{b}</li>)}</ul>
          </div>
        </article>
        <article class="feature feature--card" data-reveal>
          <Phone {...shot('solvedExercise')} />
          <div class="feature__text">
            <h3>{f.exercises.title}</h3>
            <p>{f.exercises.body}</p>
            <ul class="ticks">{f.exercises.bullets.map((b) => <li>{b}</li>)}</ul>
          </div>
        </article>
      </div>

      <div class="feature-duo">
        <FeatureCard {...f.school} image="opponents/master.webp" />
        <article class="feature feature--card" data-reveal>
          <Phone {...shot('stars')} />
          <div class="feature__text">
            <h3>{f.stars.title}</h3>
            <p>{f.stars.body}</p>
            <ul class="ticks">{f.stars.bullets.map((b) => <li>{b}</li>)}</ul>
          </div>
        </article>
      </div>

      <article class="feature feature--flip" data-reveal>
        <div class="feature__text">
          <h3>{f.journey.title}</h3>
          <p>{f.journey.body}</p>
          <ul class="ticks">{f.journey.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
        <div class="feature__media feature__media--pair">
          <Phone {...phone('journey')} />
          <Phone {...shot('achievements')} />
        </div>
      </article>

      <div class="feature-duo">
        <article class="feature feature--card" data-reveal>
          <Phone {...phone('speedrun')} />
          <div class="feature__text">
            <h3>{f.speedrun.title}</h3>
            <p>{f.speedrun.body}</p>
            <ul class="ticks">{f.speedrun.bullets.map((b) => <li>{b}</li>)}</ul>
          </div>
        </article>
        <article class="feature feature--card" data-reveal>
          <Phone {...shot('gameEnd')} />
          <div class="feature__text">
            <h3>{f.analysis.title}</h3>
            <p>{f.analysis.body}</p>
            <ul class="ticks">{f.analysis.bullets.map((b) => <li>{b}</li>)}</ul>
          </div>
        </article>
      </div>

      <article class="feature" data-reveal>
        <div class="feature__text">
          <h3>{f.marathon.title}</h3>
          <p>{f.marathon.body}</p>
          <ul class="ticks">{f.marathon.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
        <div class="feature__media feature__media--pair">
          <Phone {...phone('marathon')} />
          <Phone {...shot('record')} />
        </div>
      </article>

      <article class="feature feature--flip" data-reveal>
        <div class="feature__text">
          <h3>{f.blind.title}</h3>
          <p>{f.blind.body}</p>
          <ul class="ticks">{f.blind.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
        <div class="feature__media">
          <div class="carousel" data-carousel>
            <figure class="phone carousel__phone">
              <div class="phone__screen">
                <div class="carousel__track">
                  {
                    blindStills.map((still) => (
                      <img
                        src={asset(`${dir}/${stills[still]}.webp`)}
                        alt={t.media[still]}
                        width={clipSize.width}
                        height={clipSize.height}
                        loading="lazy"
                        decoding="async"
                      />
                    ))
                  }
                  <img
                    src={asset(`${dir}/${stills[blindStills[0]]}.webp`)}
                    alt=""
                    aria-hidden="true"
                    width={clipSize.width}
                    height={clipSize.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </figure>
            <p class="carousel__caption" aria-live="polite" data-carousel-caption>{t.features.blindShots[0]}</p>
            <div class="carousel__dots">
              {
                t.features.blindShots.map((caption, i) => (
                  <button
                    type="button"
                    aria-label={caption}
                    aria-current={i === 0 ? 'true' : undefined}
                    data-caption={caption}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </article>

      <div class="feature-duo feature-duo--single">
        <FeatureCard {...f.voice} icon={icons.voice} />
      </div>

      <div class="feature-duo">
        <article class="feature feature--card" data-reveal>
          <Phone {...shot('profile')} />
          <div class="feature__text">
            <h3>{f.progress.title}</h3>
            <p>{f.progress.body}</p>
            <ul class="ticks">{f.progress.bullets.map((b) => <li>{b}</li>)}</ul>
          </div>
        </article>
        <article class="feature feature--card" data-reveal>
          <Phone {...shot('theme')} />
          <div class="feature__text">
            <h3>{f.custom.title}</h3>
            <p>{f.custom.body}</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="levels" aria-labelledby="levels-title">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <p class="kicker">{t.levels.kicker}</p>
        <h2 id="levels-title">{t.levels.title}</h2>
      </header>
      <div class="levels__grid">
        <article class="level-card" data-reveal>
          <img src={asset('pieces/wP.webp')} alt="" width="96" height="96" loading="lazy" />
          <h3>{t.levels.beginner.title}</h3>
          <p>{t.levels.beginner.body}</p>
        </article>
        <article class="level-card level-card--strong" data-reveal>
          <img src={asset('pieces/wQ.webp')} alt="" width="96" height="96" loading="lazy" />
          <h3>{t.levels.advanced.title}</h3>
          <p>{t.levels.advanced.body}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="roadmap" id="roadmap" aria-labelledby="roadmap-title">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <p class="kicker">{t.roadmap.kicker}</p>
        <h2 id="roadmap-title">{t.roadmap.title}</h2>
      </header>
      <ol class="timeline">
        {
          t.roadmap.items.map((item, i) => (
            <li class:list={['timeline__item', { 'timeline__item--now': i === 0 }]} data-reveal style={`--delay:${i * 120}ms`}>
              <span class="timeline__status">{item.status}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="support" id="apoie" aria-labelledby="support-title">
    <div class="wrap support__grid">
      <div>
        <p class="kicker">{t.support.kicker}</p>
        <h2 id="support-title">{t.support.title}</h2>
        {t.support.body.map((p) => <p class="body">{p}</p>)}
      </div>
      <div class="supporters" data-reveal>
        <div class="supporters__avatars" aria-hidden="true">
          <img src={asset('opponents/beachgoer.webp')} alt="" width="80" height="80" loading="lazy" />
          <img src={asset('opponents/grandpa.webp')} alt="" width="80" height="80" loading="lazy" />
          <img src={asset('opponents/prodigy.webp')} alt="" width="80" height="80" loading="lazy" />
          <span>+</span>
        </div>
        <h3>{t.support.cardTitle}</h3>
        <p>{t.support.cardBody}</p>
        <a class="btn btn--accent" href={mail(t.support.subject)}>{t.support.cta}</a>
        <p class="supporters__mail">{links.email}</p>
      </div>
      <p class="support__note">{t.support.note}</p>
    </div>
  </section>

  <section class="tester" id="testador" aria-labelledby="tester-title">
    <div class="wrap">
      <div class="tester__panel" data-reveal>
        <img class="tester__mascot" src={asset('mascot-dark.webp')} alt="" width="480" height="480" loading="lazy" />
        <p class="kicker">{t.tester.kicker}</p>
        <h2 id="tester-title">{t.tester.title}</h2>
        <p class="body">{t.tester.body}</p>
        <a class="btn btn--light" href={links.tester} rel="noopener">{t.tester.cta}</a>
        <p class="tester__safety">
          {t.tester.safety}{' '}
          <a href={links.firebase} rel="noopener">{t.tester.safetyLink}</a>.
        </p>
        <p class="tester__wait">{t.tester.wait}</p>
        <p class="tester__teachers">{t.tester.teachers}</p>
        <p class="tester__thanks">{t.tester.thanks}</p>
      </div>
    </div>
  </section>

  <section class="vision" aria-labelledby="vision-title">
    <div class="wrap vision__inner" data-reveal>
      <p class="kicker">{t.vision.kicker}</p>
      <h2 id="vision-title">{t.vision.title}</h2>
      <p class="body">{t.vision.body}</p>
      <a class="btn btn--ghost" href="#testador">{t.vision.cta}</a>
    </div>
  </section>

  <section class="refs" aria-labelledby="refs-title">
    <div class="wrap">
      <p class="kicker">{t.refs.kicker}</p>
      <h2 id="refs-title">{t.refs.title}</h2>
      <ul class="refs__list">
        {
          t.refs.items.map((item, i) => (
            <li>
              <a href={refUrls[i]} rel="noopener">{item.name}</a>
              <span>{item.body}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</main>

<SiteFooter locale={locale} />

<script>
  // Entrada das seções ao rolar e contagem dos números. Sem JS, tudo aparece.
  const reveal = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as HTMLElement;
        el.classList.add('is-in');
        reveal.unobserve(el);
        const counter = el.querySelector<HTMLElement>('[data-count]');
        if (counter && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const target = Number(counter.dataset.count);
          const start = performance.now();
          const tick = (now: number) => {
            const k = Math.min(1, (now - start) / 1200);
            counter.textContent = String(Math.round(target * (1 - (1 - k) ** 3)));
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      }
    },
    { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
  );
  for (const el of document.querySelectorAll('[data-reveal]')) reveal.observe(el);

  // Vídeos: só baixam e tocam quando aparecem na tela, e param ao sair.
  // Com movimento reduzido, nada toca sozinho: o botão dá o play.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phones = [...document.querySelectorAll<HTMLElement>('[data-phone]')];

  const setPlaying = (phone: HTMLElement, playing: boolean) => {
    const button = phone.querySelector<HTMLButtonElement>('.phone__toggle')!;
    phone.classList.toggle('is-playing', playing);
    button.setAttribute('aria-label', playing ? button.dataset.pause! : button.dataset.play!);
  };

  const play = (phone: HTMLElement) => {
    const video = phone.querySelector('video')!;
    video.play().then(
      () => setPlaying(phone, true),
      () => setPlaying(phone, false),
    );
  };
  const pause = (phone: HTMLElement) => {
    phone.querySelector('video')!.pause();
    setPlaying(phone, false);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const phone = entry.target as HTMLElement;
        if (phone.dataset.paused === 'user') continue;
        if (entry.isIntersecting) play(phone);
        else pause(phone);
      }
    },
    { threshold: 0.45 },
  );

  for (const phone of phones) {
    phone.querySelector('.phone__toggle')!.addEventListener('click', () => {
      if (phone.classList.contains('is-playing')) {
        phone.dataset.paused = 'user';
        pause(phone);
      } else {
        delete phone.dataset.paused;
        play(phone);
      }
    });
    if (!reduced) observer.observe(phone);
  }

  // Carrossel do modo às cegas: desliza para a esquerda a cada 2,8 s. Depois
  // da 4ª tela vem uma cópia da 1ª, e o trilho volta ao início sem transição.
  // Para com o mouse em cima e fora da tela; com movimento reduzido, só os pontos.
  for (const carousel of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = carousel.querySelector<HTMLElement>('.carousel__track')!;
    const caption = carousel.querySelector<HTMLElement>('[data-carousel-caption]')!;
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>('.carousel__dots button')];
    const count = dots.length;
    let index = 0;
    let timer: number | undefined;
    let visible = false;
    let hovered = false;

    const show = (next: number, animate = true) => {
      index = next;
      track.style.transition = animate && !reduced ? '' : 'none';
      track.style.transform = `translateX(${-index * 100}%)`;
      const current = index % count;
      caption.textContent = dots[current].dataset.caption!;
      dots.forEach((dot, i) => dot.toggleAttribute('aria-current', i === current));
    };
    track.addEventListener('transitionend', () => {
      if (index < count) return;
      show(0, false);
      void track.offsetWidth;
    });
    const stop = () => {
      clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      if (reduced || !visible || hovered) return;
      timer = window.setInterval(() => show(index + 1), 2800);
    };
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        start();
      }),
    );
    carousel.addEventListener('mouseenter', () => {
      hovered = true;
      stop();
    });
    carousel.addEventListener('mouseleave', () => {
      hovered = false;
      start();
    });
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible) start();
        else stop();
      },
      { threshold: 0.35 },
    ).observe(carousel);
  }
</script>
