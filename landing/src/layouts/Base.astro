---
import '@fontsource-variable/inter';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import jakartaUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import { asset, defaultLocale, fallbackLocale, locales, pageUrl, privacyUrl, type Locale } from '../i18n';
import { mediaDir } from '../media';

interface Props {
  locale: Locale;
  /** A página: a landing (padrão) ou a política de privacidade. */
  page?: 'home' | 'privacy';
}

const { locale, page = 'home' } = Astro.props;
const t = locales[locale].dict;
const home = page === 'home';
const urlOf = (l: Locale) => (home ? pageUrl(l) : privacyUrl(l));
const title = home ? t.meta.title : `${t.privacy.title} · Lucena`;
const description = home ? t.meta.description : t.privacy.description;
const site = Astro.site!;
const absolute = (path: string) => new URL(path, site).href;
const canonical = absolute(urlOf(locale));
const ogImage = absolute(asset(locale === defaultLocale ? 'og-image.png' : `og-image-${locale}.png`));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Lucena',
  description: t.meta.description,
  url: absolute(pageUrl(locale)),
  image: ogImage,
  screenshot: absolute(asset(`${mediaDir(locale)}/desafio-jornada.webp`)),
  applicationCategory: 'EducationalApplication',
  applicationSubCategory: 'Chess',
  operatingSystem: 'Android',
  inLanguage: Object.values(locales).map((l) => l.hreflang),
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Gabriel Novais Cortes' },
};
---

<!doctype html>
<html lang={locales[locale].hreflang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      Object.entries(locales).map(([key, l]) => (
        <link rel="alternate" hreflang={l.hreflang} href={absolute(urlOf(key as Locale))} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absolute(urlOf(fallbackLocale))} />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F5F7F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14211B" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="32x32" href={asset('favicon-32.png')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    {home && <link rel="preload" href={asset(`${mediaDir(locale)}/maia-partida-poster.webp`)} as="image" fetchpriority="high" />}
    <link rel="preload" href={jakartaUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lucena" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={locales[locale].og} />
    {
      Object.entries(locales)
        .filter(([key]) => key !== locale)
        .map(([, l]) => <meta property="og:locale:alternate" content={l.og} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />

    {home && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Aplica o tema salvo antes de pintar, para não piscar. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <slot />
    <script>
      // Tema: alterna entre claro e escuro e guarda a escolha neste navegador.
      const root = document.documentElement;
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const current =
          root.dataset.theme ??
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
