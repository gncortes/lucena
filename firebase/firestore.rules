rules_version = '2';

// O Firestore do Lucena (E1.02). Tudo fechado por padrão; cada coleção abre só
// o que o app usa, com lista fechada de chaves, tipos e tamanhos iguais aos do
// app. Resumo em firebase/README.md; ficha de abuso em docs/fluxos/abuso.md;
// testes no emulador em firebase/test (npm --prefix firebase/test test).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Administrador: quem tem documento em admins/{uid} (criado no console).
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Bloqueio (P0-4): bloqueios/{uid}, gravado só pelo admin. Vale enquanto
    // existir e não tiver `ate` no passado. Fica fora de users/{uid} porque o
    // dono pode apagar o próprio perfil. Apagar continua liberado (LGPD).
    function blocked(uid) {
      let path = /databases/$(database)/documents/bloqueios/$(uid);
      return exists(path) && (
        !('ate' in get(path).data) ||
        get(path).data.ate == null ||
        get(path).data.ate > request.time);
    }

    // O dono, sem bloqueio vigente.
    function canWrite(uid) {
      return isOwner(uid) && !blocked(uid);
    }

    function data() {
      return request.resource.data;
    }

    function onlyKeys(allowed) {
      return data().keys().hasOnly(allowed);
    }

    // [field] ausente ou texto até [max] caracteres, dentro de [map].
    function optString(map, field, max) {
      return !(field in map) || (map[field] is string && map[field].size() <= max);
    }

    function optInt(map, field) {
      return !(field in map) || map[field] is int;
    }

    function optTimestamp(map, field) {
      return !(field in map) || map[field] is timestamp;
    }

    function optList(map, field, max) {
      return !(field in map) || (map[field] is list && map[field].size() <= max);
    }

    function optMap(map, field, max) {
      return !(field in map) || (map[field] is map && map[field].size() <= max);
    }

    // O que o documento tinha antes (vazio na criação).
    function previous() {
      return resource == null ? {} : resource.data;
    }

    function changed() {
      return data().diff(previous()).affectedKeys();
    }

    // ---------------------------------------------------------------- perfil

    // O aceite dos Termos (legal_consent_repository.dart).
    function validLegal(legal) {
      return legal is map
        && legal.keys().hasOnly(['acceptedVersion', 'acceptedAt'])
        && optInt(legal, 'acceptedVersion')
        && optString(legal, 'acceptedAt', 40);
    }

    // O perfil. Direitos pagos (premium) nunca são gravados pelo app: chegam
    // pelo servidor (Admin SDK), que passa por cima destas regras.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if canWrite(uid)
        && onlyKeys(['name', 'language', 'createdAt', 'updatedAt', 'legal'])
        && optString(data(), 'name', 80)
        && optString(data(), 'language', 16)
        && data().updatedAt is timestamp
        && (!('legal' in data()) || validLegal(data().legal))
        // createdAt: só a hora do servidor, quando muda.
        && (!changed().hasAny(['createdAt']) || data().createdAt == request.time);

      // O resumo do progresso (E1.13): um documento só, `summary`.
      match /progress/{doc} {
        allow read, delete: if isOwner(uid);
        allow create, update: if canWrite(uid) && doc == 'summary'
          && validSummary(data());
      }

      // O token do push do último aparelho em que a conta entrou (um só).
      // O admin lê para mandar o aviso de teste a uma conta e para saber se o
      // presente chega por push (H-R5-31): `permissao` do sistema, quando o
      // app conferiu e a última abertura. O app grava em duas escritas com
      // merge (token; permissão), então vale o documento inteiro.
      match /push/{doc} {
        allow read: if isOwner(uid) || isAdmin();
        allow delete: if isOwner(uid);
        allow create, update: if canWrite(uid) && doc == 'device'
          && onlyKeys(['token', 'updatedAt', 'permissao', 'conferidoEm',
                       'ultimaAbertura'])
          && data().token is string
          && optString(data(), 'token', 4096)
          && data().updatedAt is timestamp
          && (!('permissao' in data())
              || data().permissao in ['permitida', 'negada', 'nunca'])
          && optTimestamp(data(), 'conferidoEm')
          && optTimestamp(data(), 'ultimaAbertura');
      }

      // Uma partida terminada por documento: não muda depois de gravada. Id
      // `<microssegundos>-<posição>` (SyncRepository.gameId). Cada partida
      // nova soma 1 em cotas/{uid}.partidas, no mesmo lote, até o teto.
      match /games/{game} {
        allow read, delete: if isOwner(uid);
        allow create: if canWrite(uid)
          && game.matches('^[0-9]{1,20}-[A-Za-z0-9_-]{1,80}$')
          && validGame(data())
          && gamesAfter(uid) == gamesBefore(uid) + 1;
      }

      // T87 · Treinador: conta ligada e estatísticas. Só o servidor grava (callables).
      match /treinador/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // T87 · Partidas importadas e analisadas pelo servidor. O dono só espelha o
      // progresso dos exercícios; o painel só põe uma partida com erro de volta na fila.
      match /partidas/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow update: if canWrite(uid)
          && changed().hasOnly(['progresso'])
          && data().progresso is map
          && data().progresso.keys().hasOnly(['feitos', 'acertos', 'pontos', 'resultados', 'viuAnalise'])
          && optInt(data().progresso, 'feitos')
          && optInt(data().progresso, 'acertos')
          && optInt(data().progresso, 'pontos')
          && (!('resultados' in data().progresso)
            || (data().progresso.resultados is map && data().progresso.resultados.size() <= 10))
          && (!('viuAnalise' in data().progresso) || data().progresso.viuAnalise is bool);
        allow update: if isAdmin()
          && changed().hasOnly(['status'])
          && previous().status == 'erro' && data().status == 'na_fila';
      }
    }

    // O ProgressSummary.toJson (progress_summary.dart). As listas e mapas têm
    // teto; o apelido tem 20 caracteres, como no app (user_profile.dart).
    function validSummary(d) {
      return d.keys().hasOnly(['learningV1', 'profile', 'rating', 'lessons',
          'school', 'stars', 'challenges', 'positions', 'startRung',
          'speedruns', 'race', 'featured', 'updatedAt'])
        && d.profile is map
        && validProfile(d.profile)
        && optList(d, 'learningV1', 5000)
        && (!('rating' in d) || (d.rating is map
            && d.rating.keys().hasOnly(['rating', 'deviation', 'volatility'])))
        && optMap(d, 'lessons', 2000)
        && optList(d, 'school', 5000)
        && optMap(d, 'stars', 5000)
        && optList(d, 'challenges', 5000)
        && optList(d, 'positions', 5000)
        && optInt(d, 'startRung')
        && optMap(d, 'speedruns', 500)
        && optMap(d, 'race', 50)
        && optList(d, 'featured', 5000)
        && optTimestamp(d, 'updatedAt');
    }

    function validProfile(p) {
      return p.keys().hasOnly(['nickname', 'rating', 'goal', 'levelSource',
          'lichessUser', 'lichessLinkedAt', 'chessComUser', 'avatarColor',
          'photo', 'photoUrl', 'country', 'state', 'city', 'googlePhoto'])
        && optString(p, 'nickname', 20)
        && optInt(p, 'rating')
        && optString(p, 'goal', 32)
        && optString(p, 'levelSource', 32)
        && optString(p, 'lichessUser', 50)
        && optString(p, 'lichessLinkedAt', 40)
        && optString(p, 'chessComUser', 50)
        && optInt(p, 'avatarColor')
        && optString(p, 'photo', 16)
        && optString(p, 'photoUrl', 2048)
        && optString(p, 'country', 8)
        && optString(p, 'state', 64)
        && optString(p, 'city', 120)
        && (!('googlePhoto' in p) || p.googlePhoto is bool);
    }

    // O SyncRepository.gameJson (sync_repository.dart).
    function validGame(g) {
      return g.keys().hasOnly(['positionId', 'playedAt', 'outcome',
          'fulfilled', 'opponent', 'opponentLevel', 'startedAt', 'startFen',
          'moves', 'userSide', 'endReason', 'challengeId'])
        && g.positionId is string && g.positionId.size() <= 100
        && g.playedAt is timestamp
        && optString(g, 'outcome', 16)
        && (!('fulfilled' in g) || g.fulfilled is bool)
        && optString(g, 'opponent', 32)
        && optInt(g, 'opponentLevel')
        && optTimestamp(g, 'startedAt')
        && optString(g, 'startFen', 100)
        && optString(g, 'moves', 6000)
        && optString(g, 'userSide', 8)
        && optString(g, 'endReason', 32)
        && optString(g, 'challengeId', 100);
    }

    // ----------------------------------------------------------------- cotas

    // cotas/{uid}: o ritmo do feedback e a contagem de partidas. O dono só
    // avança (nunca volta nem apaga); some sozinho com a política de TTL em
    // `feedbackEm` (docs/tasks/T85-app-check-passos.md).
    function cota(uid) {
      return /databases/$(database)/documents/cotas/$(uid);
    }

    function gamesBefore(uid) {
      return exists(cota(uid)) && ('partidas' in get(cota(uid)).data)
        ? get(cota(uid)).data.partidas : 0;
    }

    function gamesAfter(uid) {
      return existsAfter(cota(uid)) && ('partidas' in getAfter(cota(uid)).data)
        ? getAfter(cota(uid)).data.partidas : 0;
    }

    // O teto de partidas por conta.
    function maxGames() {
      return 20000;
    }

    // O intervalo mínimo entre dois feedbacks da mesma conta.
    function feedbackGap() {
      return duration.value(60, 's');
    }

    function feedbackStep() {
      return changed().hasOnly(['feedbackEm', 'feedbackId'])
        && data().feedbackEm == request.time
        && data().feedbackId is string
        && data().feedbackId.size() <= 40
        && existsAfter(/databases/$(database)/documents/feedback/$(data().feedbackId))
        && (!('feedbackEm' in previous())
            || previous().feedbackEm + feedbackGap() <= request.time);
    }

    function gamesStep() {
      return changed().hasOnly(['partidas'])
        && data().partidas is int
        && data().partidas == (('partidas' in previous()) ? previous().partidas : 0) + 1
        && data().partidas <= maxGames();
    }

    match /cotas/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow create, update: if canWrite(uid)
        && onlyKeys(['feedbackEm', 'feedbackId', 'partidas'])
        && (feedbackStep() || gamesStep());
    }

    // -------------------------------------------------------------- feedback

    // Os avisos de problema e as sugestões (E1.26): só com conta, com o uid
    // do autor, chaves do FeedbackEntry.toJson, texto até 500 (o do app) e
    // um envio por minuto por conta (cotas/{uid}, no mesmo lote).
    match /feedback/{id} {
      allow create: if signedIn() && !blocked(request.auth.uid)
        && onlyKeys(['uid', 'kind', 'type', 'text', 'level', 'origin',
                     'appVersion', 'model', 'manufacturer', 'language',
                     'createdAt'])
        && data().uid == request.auth.uid
        && data().text is string
        && data().text.size() > 0
        && data().text.size() <= 500
        && optString(data(), 'kind', 32)
        && (!('type' in data()) || data().type in ['problema', 'ideia', 'elogio'])
        && optString(data(), 'level', 32)
        && optString(data(), 'origin', 32)
        && optString(data(), 'appVersion', 32)
        && optString(data(), 'model', 64)
        && optString(data(), 'manufacturer', 64)
        && optString(data(), 'language', 32)
        && data().createdAt == request.time
        && getAfter(cota(request.auth.uid)).data.feedbackId == id
        && getAfter(cota(request.auth.uid)).data.feedbackEm == request.time;
      // O dono lê e apaga o que mandou (exclusão da conta); a consulta tem de
      // filtrar por uid.
      allow get, list, delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
    }

    // ------------------------------------------------------- só o servidor

    // Bloqueio vigente da conta: o admin grava (painel), o dono lê para o app
    // mostrar o estado. O histórico (moderacao/*) fica para a Cloud Function.
    match /bloqueios/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && onlyKeys(['motivo', 'regra', 'desde', 'ate', 'adminUid'])
        && data().motivo is string && data().motivo.size() <= 64
        && optString(data(), 'regra', 16)
        && data().desde is timestamp
        && (!('ate' in data()) || data().ate == null || data().ate is timestamp)
        && optString(data(), 'adminUid', 128);
      allow delete: if isAdmin();
    }

    // Os cursos da conta (H-R5-31): `cursos.{id}` só a Cloud Function grava
    // (compra, presente, revogação); o dono só marca o que já viu
    // (`vistos.{id}: timestamp`, o aviso de curso novo). Ninguém cria nem
    // apaga pelo app.
    match /acessos/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if isOwner(uid)
        && changed().hasOnly(['vistos'])
        && data().vistos is map
        && data().vistos.size() <= 200;

      // O histórico da Ficha (dar, revogar, desfazer, bloqueio).
      match /registro/{id} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Os números do painel: fechamento do dia e do mês, o lote de hoje, os
    // pontos de atenção e os envios de push. Só a Function grava; só o admin
    // lê.
    match /resumosDia/{dia} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /resumosMes/{mes} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /painel/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pushes/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // O relatório do dia para o agente (sem dado pessoal): o agente lê pelo
    // Admin SDK, fora destas regras; pelo app, só o admin.
    match /relatorios/{dia} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Correções de fala e versões do conteúdo: só pelas Functions.
    match /pedidosCorrecao/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /revisoes/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Os índices de pacotes (H-R5-38): conteudo/teste (app de teste) e
    // conteudo/alunos. Quem tem conta lê; só publicarVersao e reverterVersao gravam.
    match /conteudo/{indice} {
      allow get: if signedIn() && indice in ['teste', 'alunos'];
      allow list, write: if false;
    }

    // O que o agente sugere (pelo Admin SDK) e o que o Gabriel decide (pela
    // Function decidirEntrega): pelo app, só leitura do admin.
    match /entregas/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /decisoes/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Agentes noturnos (AG-5b.1): o porteiro importarLote grava o lote
    // (idempotência), a quarentena com o motivo e a contagem da noite. Pelo
    // app, só leitura do admin.
    match /lotes/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /quarentena/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /agentesNoite/{noite} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Teto mensal (150 entregas) e a pausa dos agentes: só o porteiro grava.
    match /agentesMes/{mes} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /config/agentes {
      allow read: if isAdmin();
      allow write: if false;
    }

    // As promoções: o app do aluno só consulta pela Function validarCupom.
    match /promocoes/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Contagem de aparelhos por tópico (TopicCountService): só uma Cloud
    // Function (Admin SDK) grava; o painel lê.
    match /inscritos/{topic} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Os desafios por link (V1.1): o app não usa a coleção (o desafio vai no
    // próprio link). Fechada até existir uso, com regra própria.
    match /challenges/{code} {
      allow read, write: if false;
    }

    // As posições candidatas a final em destaque: só o painel do Gabriel.
    match /candidates/{id} {
      allow read, write: if isAdmin();
    }

    // Os finais em destaque publicados: todos leem, só o admin escreve.
    match /featured/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // T87 · Treinador: configuração e agregados do painel, partidas-modelo por ECO.
    // Fila, contas e cache da teoria (treinador_fila, treinador_contas,
    // treinador_teoria) são só do servidor: sem regra, ninguém lê pelo app.
    match /treinador_config/{doc} {
      allow read, write: if isAdmin();
    }
    match /treinador_painel/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /treinador_modelos/{eco} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // A lista de administradores: cada um vê o próprio; ninguém grava pelo app.
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow write: if false;
    }
  }
}
