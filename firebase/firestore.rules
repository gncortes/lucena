rules_version = '2';

// O Firestore do Lucena (E1.02). Tudo fechado por padrão; cada coleção abre só
// o que o app usa. Resumo das coleções em firebase/README.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Administrador: quem tem documento em admins/{uid} (criado no console).
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function shortString(field, max) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() <= max);
    }

    // O perfil. Direitos pagos (premium) nunca são gravados pelo app: chegam
    // pelo servidor (Admin SDK), que passa por cima destas regras.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && onlyKeys(['name', 'language', 'createdAt', 'updatedAt'])
        && shortString('name', 80)
        && shortString('language', 16)
        && request.resource.data.updatedAt is timestamp;

      // O resumo do progresso (E1.13).
      match /progress/{doc} {
        allow read, write: if isOwner(uid);
      }

      // Uma partida terminada por documento: não muda depois de gravada.
      match /games/{game} {
        allow read, create, delete: if isOwner(uid);
      }
    }

    // Os avisos de problema e as sugestões (E1.19). Com ou sem conta.
    match /feedback/{id} {
      allow create: if onlyKeys(['uid', 'kind', 'text', 'appVersion',
                                 'language', 'context', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && shortString('kind', 32)
        && shortString('appVersion', 32)
        && shortString('language', 16)
        && (!('uid' in request.resource.data) ||
            isOwner(request.resource.data.uid))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Os desafios por link (V1.1): quem tem o código lê; o dono cria; o
    // resultado de quem aceitou entra uma vez só.
    match /challenges/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && !('result' in request.resource.data);
      allow update: if signedIn()
        && !('result' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['result']);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // As posições candidatas a final em destaque: só o painel do Gabriel.
    match /candidates/{id} {
      allow read, write: if isAdmin();
    }

    // Os finais em destaque publicados: todos leem, só o admin escreve.
    match /featured/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A lista de administradores: cada um vê o próprio; ninguém grava pelo app.
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow write: if false;
    }
  }
}
