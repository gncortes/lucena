rules_version = '2';

// O Firestore do Lucena (E1.02). Tudo fechado por padrão; cada coleção abre só
// o que o app usa. Resumo das coleções em firebase/README.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Administrador: quem tem documento em admins/{uid} (criado no console).
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function shortString(field, max) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() <= max);
    }

    // O perfil. Direitos pagos (premium) nunca são gravados pelo app: chegam
    // pelo servidor (Admin SDK), que passa por cima destas regras.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && onlyKeys(['name', 'language', 'createdAt', 'updatedAt'])
        && shortString('name', 80)
        && shortString('language', 16)
        && request.resource.data.updatedAt is timestamp;

      // O resumo do progresso (E1.13).
      match /progress/{doc} {
        allow read, write: if isOwner(uid);
      }

      // Uma partida terminada por documento: não muda depois de gravada.
      match /games/{game} {
        allow read, create, delete: if isOwner(uid);
      }
    }

    // A opinião (E1.25/E1.26): "pagaria?" (respostas em códigos) ou livre
    // (problema, ideia ou elogio). Anônima: sem uid, e-mail nem nome.
    function validAnswers(answers) {
      return answers is map
        && answers.keys().hasOnly(['course', 'coursePrice', 'coach',
                                   'coachPrice', 'learn', 'next', 'why',
                                   'level'])
        && (!('next' in answers) ||
            (answers.next is string && answers.next.size() <= 200))
        && (!('why' in answers) ||
            (answers.why is list && answers.why.size() <= 10));
    }

    match /feedback/{id} {
      allow create: if onlyKeys(['kind', 'type', 'text', 'answers', 'level',
                                 'origin', 'appVersion', 'model',
                                 'manufacturer', 'language', 'createdAt'])
        && (request.resource.data.kind == 'livre'
          ? request.resource.data.type in ['problema', 'ideia', 'elogio']
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && !('answers' in request.resource.data)
          : request.resource.data.kind == 'pagaria'
            && validAnswers(request.resource.data.answers)
            && !('type' in request.resource.data)
            && !('text' in request.resource.data))
        && shortString('level', 32)
        && shortString('origin', 32)
        && shortString('appVersion', 32)
        && shortString('model', 64)
        && shortString('manufacturer', 64)
        && shortString('language', 32)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Os desafios por link (V1.1): quem tem o código lê; o dono cria; o
    // resultado de quem aceitou entra uma vez só.
    match /challenges/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && !('result' in request.resource.data);
      allow update: if signedIn()
        && !('result' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['result']);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // As posições candidatas a final em destaque: só o painel do Gabriel.
    match /candidates/{id} {
      allow read, write: if isAdmin();
    }

    // Os finais em destaque publicados: todos leem, só o admin escreve.
    match /featured/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // "x% acertaram" do final do dia (E1.24): a função agendada da E1.20
    // grava pelo Admin SDK, que não passa pelas regras; o app só lê.
    match /daily/{day} {
      allow get: if true;
      allow list, write: if false;
    }

    // A lista de administradores: cada um vê o próprio; ninguém grava pelo app.
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow write: if false;
    }
  }
}
