rules_version = '2';

// O Storage do Lucena (§2.12). Só a foto de perfil enviada pelo usuário; o
// resto fica fechado. Resumo em firebase/README.md.
service firebase.storage {
  match /b/{bucket}/o {

    // users/{uid}/avatar.jpg: só o dono lê, troca e apaga. Imagem até 1 MB
    // (a tela já manda o JPEG reduzido).
    match /users/{uid}/avatar.jpg {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
