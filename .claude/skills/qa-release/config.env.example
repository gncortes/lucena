# Modelo da configuração do workflow .github/workflows/qa.yml. Como preencher: SETUP.md.
# Copiar para config.env (não versionado), preencher e gravar no GitHub:
#   gh secret set QA_CONFIG_ENV --env release < .claude/skills/qa-release/config.env

# Projeto e app no Firebase
FIREBASE_PROJECT_ID="lucena-xxxxx"
FIREBASE_ANDROID_APP_ID="1:000000000000:android:0000000000000000"

# Login do GitHub Actions no Google Cloud sem chave (Workload Identity Federation).
# São identificadores, não segredos: o acesso é liberado só para este repositório.
GCP_WORKLOAD_IDENTITY_PROVIDER=""
GCP_SERVICE_ACCOUNT=""

# Grupo de testadores no App Distribution (alias do grupo)
TESTER_GROUP="qa"

# Aparelhos do Test Lab: um por linha "model=...,version=...,locale=...,orientation=portrait"
# Conferir modelos disponíveis: gcloud firebase test android models list
TEST_LAB_DEVICES="model=MediumPhone.arm,version=34,locale=pt_BR,orientation=portrait
model=SmallPhone.arm,version=30,locale=ar,orientation=portrait"

# Tempo máximo da execução no Test Lab
TEST_LAB_TIMEOUT="15m"
