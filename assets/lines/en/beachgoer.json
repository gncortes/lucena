  "lines": [
    {
      "id": "beachgoer.gameStart.1",
      "category": "gameStart",
      "intensity": 1,
      "emotion": "calm",
      "text": "Hey buddy! Pull up a beach chair, we're taking it easy today."
    },
    {
      "id": "beachgoer.gameStart.2",
      "category": "gameStart",
      "intensity": 1,
      "emotion": "happy",
      "text": "Sun on my face, coconut in hand, a board to play. Living the dream."
