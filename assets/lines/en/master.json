{
  "character": "master",
  "language": "en",
  "lines": [
    {
      "id": "master.gameStart.1",
      "category": "gameStart",
      "intensity": 1,
      "emotion": "calm",
      "text": "Good afternoon. Sit down. Endgames are where real chess is learned."
    },
    {
      "id": "master.gameStart.2",
      "category": "gameStart",
      "intensity": 1,
      "emotion": "focused",
      "text": "Few pieces, nowhere to hide. Show me what you know."
    },
    {
      "id": "master.gameStart.3",
      "category": "gameStart",
      "intensity": 2,
      "emotion": "confident",
      "text": "Today's first lesson: in the endgame, the king is a strong piece."
    },
    {
      "id": "master.gameStart.4",
      "category": "gameStart",
      "intensity": 2,
      "emotion": "calm",
      "text": "Breathe. Find your plan before you touch a piece."
    },
    {
      "id": "master.gameStart.5",
      "category": "gameStart",
      "intensity": 3,
      "emotion": "focused",
      "text": "Do not expect me to go easy. Expect a good lesson."
    },
    {
      "id": "master.gameStart.6",
      "category": "gameStart",
      "intensity": 1,
      "emotion": "calm",
      "text": "Tie straightened. We may begin."
    },
    {
      "id": "master.gameStart.7",
      "category": "gameStart",
      "intensity": 1,
      "emotion": "happy",
      "text": "Capablanca began with endgames. So shall we."
    },
    {
      "id": "master.gameStart.8",
      "category": "gameStart",
      "intensity": 2,
      "emotion": "calm",
      "text": "My first teacher said: respect every piece. Let us play."
    },
    {
      "id": "master.gameStart.9",
      "category": "gameStart",
      "intensity": 1,
      "emotion": "calm",
      "text": "How good to meet someone who studies endgames. There are few."
    },
    {
      "id": "master.gameStart.10",
      "category": "gameStart",
      "intensity": 2,
      "emotion": "focused",
      "text": "Play as if every move will be studied later. It will be."
    },
    {
      "id": "master.gameStart.11",
      "category": "gameStart",
      "intensity": 3,
      "emotion": "confident",
      "text": "I reached the top for this: to play those who want to learn."
    },
    {
      "id": "master.gameStart.12",
      "category": "gameStart",
      "intensity": 1,
      "emotion": "calm",
      "text": "Recall Tarrasch: before the endgame, the gods placed the middlegame."
    },
    {
      "id": "master.gameStart.13",
      "category": "gameStart",
      "intensity": 2,
      "emotion": "happy",
      "text": "You climbed the whole ladder. I know what that costs."
    },
    {
      "id": "master.gameStart.14",
      "category": "gameStart",
      "intensity": 2,
      "emotion": "happy",
      "text": "I remember your first rook crossing the board. Look at you now.",
      "audience": "student"
    },
    {
      "id": "master.gameStart.15",
      "category": "gameStart",
      "intensity": 3,
      "emotion": "happy",
      "text": "My student reached my rung. No joy is greater for a teacher.",
      "audience": "student"
    },
    {
      "id": "master.gameStart.16",
      "category": "gameStart",
      "intensity": 2,
      "emotion": "calm",
      "text": "Today I am not your teacher. I am your opponent. Honour what you learned.",
      "audience": "student"
    },
    {
      "id": "master.gameStart.17",
      "category": "gameStart",
      "intensity": 1,
      "emotion": "happy",
      "text": "The ladder, the opposition, the square... Let us see if you remember.",
      "audience": "student"
    },
    {
      "id": "master.gameStart.18",
      "category": "gameStart",
      "intensity": 3,
      "emotion": "focused",
      "text": "I taught you all I know. Now try to beat me with it.",
      "audience": "student"
    },
    {
      "id": "master.gameStart.19",
      "category": "gameStart",
      "intensity": 2,
      "emotion": "calm",
      "text": "This is the day every teacher waits for: facing the student.",
      "audience": "student"
    },
    {
      "id": "master.gameStart.20",
      "category": "gameStart",
      "intensity": 1,
      "emotion": "calm",
      "text": "Morphy played like no one in his century. Let us honour him."
    },
    {
      "id": "master.gameStart.21",
      "category": "gameStart",
      "intensity": 2,
      "emotion": "calm",
      "text": "I always think of club teachers. Without them, there would be no masters."
    },
    {
      "id": "master.bigAdvantage.1",
      "category": "bigAdvantage",
      "intensity": 1,
      "emotion": "calm",
      "text": "Technique, nothing more. The rest has been decided."
    },
    {
      "id": "master.bigAdvantage.2",
      "category": "bigAdvantage",
      "intensity": 2,
      "emotion": "confident",
      "text": "Watch my king advance. He works, he doesn't spectate."
    },
    {
      "id": "master.bigAdvantage.3",
      "category": "bigAdvantage",
      "intensity": 2,
      "emotion": "focused",
      "text": "Winning a won position is an art. I won't relax."
    },
    {
      "id": "master.bigAdvantage.4",
      "category": "bigAdvantage",
      "intensity": 3,
      "emotion": "confident",
      "text": "This is a practical lesson now, my friend. Take notes."
    },
    {
      "id": "master.bigAdvantage.5",
      "category": "bigAdvantage",
      "intensity": 1,
      "emotion": "calm",
      "text": "No hurry. An advantage never runs from a calm player."
    },
    {
      "id": "master.bigAdvantage.6",
      "category": "bigAdvantage",
      "intensity": 3,
      "emotion": "focused",
      "text": "I cut off your king and march mine. Textbook."
    },
    {
      "id": "master.bigAdvantage.7",
      "category": "bigAdvantage",
      "intensity": 2,
      "emotion": "calm",
      "text": "Fischer said he didn't believe in psychology, only good moves."
    },
    {
      "id": "master.bigAdvantage.8",
      "category": "bigAdvantage",
      "intensity": 1,
      "emotion": "focused",
      "text": "Now we convert. Move by move, no flash, no error."
    },
    {
      "id": "master.bigAdvantage.9",
      "category": "bigAdvantage",
      "intensity": 2,
      "emotion": "calm",
      "text": "Notice: I am in no hurry. Haste is what loses won endgames."
    },
    {
      "id": "master.bigAdvantage.10",
      "category": "bigAdvantage",
      "intensity": 3,
      "emotion": "calm",
      "text": "That is how Capablanca played: simple, clean, inevitable."
    },
    {
      "id": "master.bigAdvantage.11",
      "category": "bigAdvantage",
      "intensity": 2,
      "emotion": "calm",
      "text": "You are watching the technique I taught you. From the other side now.",
      "audience": "student"
    },
    {
      "id": "master.bigAdvantage.12",
      "category": "bigAdvantage",
      "intensity": 3,
      "emotion": "focused",
      "text": "I will not go easy because you were my student. That would be disrespect.",
      "audience": "student"
    },
    {
      "id": "master.bigAdvantage.13",
      "category": "bigAdvantage",
      "intensity": 1,
      "emotion": "calm",
      "text": "Remember the lesson on cutting off with the rook? Watch.",
      "audience": "student"
    },
    {
      "id": "master.better.1",
      "category": "better",
      "intensity": 1,
      "emotion": "focused",
      "text": "A small edge. In an endgame, that is plenty."
    },
    {
      "id": "master.better.2",
      "category": "better",
      "intensity": 2,
      "emotion": "calm",
      "text": "My king is more active. That detail decides endgames."
    },
    {
      "id": "master.better.3",
      "category": "better",
      "intensity": 2,
      "emotion": "confident",
      "text": "Patience. Small improvements, one at a time."
    },
    {
      "id": "master.better.4",
      "category": "better",
      "intensity": 1,
      "emotion": "calm",
      "text": "It isn't won yet. But it's well on its way."
    },
    {
      "id": "master.better.5",
      "category": "better",
      "intensity": 3,
      "emotion": "focused",
      "text": "Constant pressure. We'll see who blinks first."
    },
    {
      "id": "master.better.6",
      "category": "better",
      "intensity": 1,
      "emotion": "calm",
      "text": "Rubinstein won endgames like this: one better square at a time."
    },
    {
      "id": "master.better.7",
      "category": "better",
      "intensity": 2,
      "emotion": "focused",
      "text": "Every tempo counts. Today they are on my side."
    },
    {
      "id": "master.better.8",
      "category": "better",
      "intensity": 1,
      "emotion": "calm",
      "text": "Improve your worst piece. Old advice, always true."
    },
    {
      "id": "master.better.9",
      "category": "better",
      "intensity": 2,
      "emotion": "calm",
      "text": "Slightly better. You know what I would do now, don't you?",
      "audience": "student"
    },
    {
      "id": "master.better.10",
      "category": "better",
      "intensity": 1,
      "emotion": "focused",
      "text": "Remember what I taught: active king. I take it seriously.",
      "audience": "student"
    },
    {
      "id": "master.equal.1",
      "category": "equal",
      "intensity": 1,
      "emotion": "calm",
      "text": "Balance. Now the better understanding will win."
    },
    {
      "id": "master.equal.2",
      "category": "equal",
      "intensity": 2,
      "emotion": "focused",
      "text": "Mind the opposition. One tempo changes everything."
    },
    {
      "id": "master.equal.3",
      "category": "equal",
      "intensity": 1,
      "emotion": "calm",
      "text": "Equal is not dead. There is work to do here."
    },
    {
      "id": "master.equal.4",
      "category": "equal",
      "intensity": 2,
      "emotion": "focused",
      "text": "Whoever centralizes the king first usually gets the edge."
    },
    {
      "id": "master.equal.5",
      "category": "equal",
      "intensity": 3,
      "emotion": "confident",
      "text": "Equal for now. Patience is worth more than talent here."
    },
    {
      "id": "master.equal.6",
      "category": "equal",
      "intensity": 1,
      "emotion": "calm",
      "text": "Lasker said: seen a good move? Look for a better one."
    },
    {
      "id": "master.equal.7",
      "category": "equal",
      "intensity": 2,
      "emotion": "calm",
      "text": "Balance is mutual respect. I like that."
    },
    {
      "id": "master.equal.8",
      "category": "equal",
      "intensity": 1,
      "emotion": "focused",
      "text": "Now small things decide. Squares, tempi, opposition."
    },
    {
      "id": "master.equal.9",
      "category": "equal",
      "intensity": 2,
      "emotion": "happy",
      "text": "Equal against me. I can already say I taught well.",
      "audience": "student"
    },
    {
      "id": "master.equal.10",
      "category": "equal",
      "intensity": 1,
      "emotion": "calm",
      "text": "Remember the king's wall? It applies here too.",
      "audience": "student"
    },
    {
      "id": "master.equal.11",
      "category": "equal",
      "intensity": 1,
      "emotion": "calm",
      "text": "Capablanca made endgames look simple. They are not."
    },
    {
      "id": "master.worse.1",
      "category": "worse",
      "intensity": 1,
      "emotion": "focused",
      "text": "Hm. I'm slightly worse. Time for precise defense."
    },
    {
      "id": "master.worse.2",
      "category": "worse",
      "intensity": 2,
      "emotion": "calm",
      "text": "Defending well is chess too. Perhaps the hardest part."
    },
    {
      "id": "master.worse.3",
      "category": "worse",
      "intensity": 2,
      "emotion": "focused",
      "text": "You've played well so far. Don't celebrate early."
    },
    {
      "id": "master.worse.4",
      "category": "worse",
      "intensity": 1,
      "emotion": "calm",
      "text": "I'll find the most stubborn defense. That's what one does."
    },
    {
      "id": "master.worse.5",
      "category": "worse",
      "intensity": 3,
      "emotion": "nervous",
      "text": "Interesting. It's been a while since I was squeezed like this."
    },
    {
      "id": "master.worse.6",
      "category": "worse",
      "intensity": 1,
      "emotion": "calm",
      "text": "Great defenders never gave up a game without a fight."
    },
    {
      "id": "master.worse.7",
      "category": "worse",
      "intensity": 2,
      "emotion": "focused",
      "text": "I am worse. Now every move of mine must be exact."
    },
    {
      "id": "master.worse.8",
      "category": "worse",
      "intensity": 2,
      "emotion": "surprised",
      "text": "Well, well. You are playing the way I taught.",
      "audience": "student"
    },
    {
      "id": "master.worse.9",
      "category": "worse",
      "intensity": 3,
      "emotion": "happy",
      "text": "I am worse and I smile. The one squeezing me is my student.",
      "audience": "student"
    },
    {
      "id": "master.bigDisadvantage.1",
      "category": "bigDisadvantage",
      "intensity": 1,
      "emotion": "calm",
      "text": "The position is bad. But the game ends only at the end."
    },
    {
      "id": "master.bigDisadvantage.2",
      "category": "bigDisadvantage",
      "intensity": 2,
      "emotion": "focused",
      "text": "I'll look for a fortress. Or a stalemate."
    },
    {
      "id": "master.bigDisadvantage.3",
      "category": "bigDisadvantage",
      "intensity": 2,
      "emotion": "frustrated",
      "text": "You've left me few exits. With all due respect."
    },
    {
      "id": "master.bigDisadvantage.4",
      "category": "bigDisadvantage",
      "intensity": 3,
      "emotion": "nervous",
      "text": "Now it is your technique on trial."
    },
    {
      "id": "master.bigDisadvantage.5",
      "category": "bigDisadvantage",
      "intensity": 1,
      "emotion": "sad",
      "text": "Hands behind my back, head held high. We play on."
    },
    {
      "id": "master.bigDisadvantage.6",
      "category": "bigDisadvantage",
      "intensity": 3,
      "emotion": "focused",
      "text": "Prove you can win this. Many cannot."
    },
    {
      "id": "master.bigDisadvantage.7",
      "category": "bigDisadvantage",
      "intensity": 2,
      "emotion": "calm",
      "text": "Lost, perhaps. But a master resigns only when fighting is useless."
    },
    {
      "id": "master.bigDisadvantage.8",
      "category": "bigDisadvantage",
      "intensity": 1,
      "emotion": "calm",
      "text": "Many won games were drawn through haste. No haste."
    },
    {
      "id": "master.bigDisadvantage.9",
      "category": "bigDisadvantage",
      "intensity": 3,
      "emotion": "happy",
      "text": "You have me against the wall. How proud I am, my student.",
      "audience": "student"
    },
    {
      "id": "master.bigDisadvantage.10",
      "category": "bigDisadvantage",
      "intensity": 2,
      "emotion": "focused",
      "text": "Now I want to see the technique I taught you. Do not disappoint me.",
      "audience": "student"
    },
    {
      "id": "master.bigDisadvantage.11",
      "category": "bigDisadvantage",
      "intensity": 1,
      "emotion": "calm",
      "text": "Remember stalemate? I will look for one. Careful.",
      "audience": "student"
    },
    {
      "id": "master.opponentBlunder.1",
      "category": "opponentBlunder",
      "intensity": 1,
      "emotion": "calm",
      "text": "Are you sure? Well, no take-backs at the club."
    },
    {
      "id": "master.opponentBlunder.2",
      "category": "opponentBlunder",
      "intensity": 2,
      "emotion": "surprised",
      "text": "Ah. That move will cost you. Observe."
    },
    {
      "id": "master.opponentBlunder.3",
      "category": "opponentBlunder",
      "intensity": 2,
      "emotion": "focused",
      "text": "Before you move, ask: what does he threaten?"
    },
    {
      "id": "master.opponentBlunder.4",
      "category": "opponentBlunder",
      "intensity": 3,
      "emotion": "confident",
      "text": "An error like that has no cure in an endgame. Lesson noted."
    },
    {
      "id": "master.opponentBlunder.5",
      "category": "opponentBlunder",
      "intensity": 1,
      "emotion": "calm",
      "text": "Haste is the endgame's enemy. Always has been."
    },
    {
      "id": "master.opponentBlunder.6",
      "category": "opponentBlunder",
      "intensity": 3,
      "emotion": "surprised",
      "text": "My friend, you forgot about my king."
    },
    {
      "id": "master.opponentBlunder.7",
      "category": "opponentBlunder",
      "intensity": 2,
      "emotion": "calm",
      "text": "We all err. What matters is understanding why, afterwards."
    },
    {
      "id": "master.opponentBlunder.8",
      "category": "opponentBlunder",
      "intensity": 1,
      "emotion": "focused",
      "text": "A slip. It happens even in world championship endgames."
    },
    {
      "id": "master.opponentBlunder.9",
      "category": "opponentBlunder",
      "intensity": 2,
      "emotion": "calm",
      "text": "I would correct that error in class. Today, I take it.",
      "audience": "student"
    },
    {
      "id": "master.opponentBlunder.10",
      "category": "opponentBlunder",
      "intensity": 3,
      "emotion": "surprised",
      "text": "Oh no! I taught you to check threats first!",
      "audience": "student"
    },
    {
      "id": "master.ownBlunder.1",
      "category": "ownBlunder",
      "intensity": 1,
      "emotion": "surprised",
      "text": "Hm. That was beneath me."
    },
    {
      "id": "master.ownBlunder.2",
      "category": "ownBlunder",
      "intensity": 2,
      "emotion": "frustrated",
      "text": "My inaccuracy. Even masters stumble."
    },
    {
      "id": "master.ownBlunder.3",
      "category": "ownBlunder",
      "intensity": 3,
      "emotion": "frustrated",
      "text": "How embarrassing. Forty years of chess, and I play that."
    },
    {
      "id": "master.ownBlunder.4",
      "category": "ownBlunder",
      "intensity": 2,
      "emotion": "calm",
      "text": "I erred. Take advantage. It won't happen twice."
    },
    {
      "id": "master.ownBlunder.5",
      "category": "ownBlunder",
      "intensity": 1,
      "emotion": "nervous",
      "text": "I straighten my tie and pretend I didn't see that."
    },
    {
      "id": "master.ownBlunder.6",
      "category": "ownBlunder",
      "intensity": 3,
      "emotion": "surprised",
      "text": "Unacceptable. My old teacher would have torn up my scoresheet."
    },
    {
      "id": "master.ownBlunder.7",
      "category": "ownBlunder",
      "intensity": 2,
      "emotion": "calm",
      "text": "Even world champions misplayed simple endings. Today it was me."
    },
    {
      "id": "master.ownBlunder.8",
      "category": "ownBlunder",
      "intensity": 1,
      "emotion": "focused",
      "text": "My error. I breathe, and play seriously again."
    },
    {
      "id": "master.ownBlunder.9",
      "category": "ownBlunder",
      "intensity": 2,
      "emotion": "happy",
      "text": "I erred, and my student saw it. That makes me happy, you know?",
      "audience": "student"
    },
    {
      "id": "master.ownBlunder.10",
      "category": "ownBlunder",
      "intensity": 3,
      "emotion": "frustrated",
      "text": "Right in front of my student! What an example I set.",
      "audience": "student"
    },
    {
      "id": "master.strongMove.1",
      "category": "strongMove",
      "intensity": 1,
      "emotion": "happy",
      "text": "Very good. That is the move of someone who understands endgames."
    },
    {
      "id": "master.strongMove.2",
      "category": "strongMove",
      "intensity": 2,
      "emotion": "surprised",
      "text": "Elegant. I would have played that myself."
    },
    {
      "id": "master.strongMove.3",
      "category": "strongMove",
      "intensity": 2,
      "emotion": "happy",
      "text": "Bravo. Active king, exactly by the book."
    },
    {
      "id": "master.strongMove.4",
      "category": "strongMove",
      "intensity": 3,
      "emotion": "surprised",
      "text": "Excellent! I rarely see anyone find that move."
    },
    {
      "id": "master.strongMove.5",
      "category": "strongMove",
      "intensity": 1,
      "emotion": "calm",
      "text": "Correct. The opposition was the key. You saw it."
    },
    {
      "id": "master.strongMove.6",
      "category": "strongMove",
      "intensity": 3,
      "emotion": "happy",
      "text": "Magnificent. Today the student taught the teacher."
    },
    {
      "id": "master.strongMove.7",
      "category": "strongMove",
      "intensity": 2,
      "emotion": "happy",
      "text": "That move has the scent of Capablanca."
    },
    {
      "id": "master.strongMove.8",
      "category": "strongMove",
      "intensity": 1,
      "emotion": "calm",
      "text": "Precise. That is how an endgame is played."
    },
    {
      "id": "master.strongMove.9",
      "category": "strongMove",
      "intensity": 2,
      "emotion": "surprised",
      "text": "Did you calculate that? My sincere congratulations."
    },
    {
      "id": "master.strongMove.10",
      "category": "strongMove",
      "intensity": 3,
      "emotion": "happy",
      "text": "That is exactly what I taught in class. Exactly!",
      "audience": "student"
    },
    {
      "id": "master.strongMove.11",
      "category": "strongMove",
      "intensity": 2,
      "emotion": "happy",
      "text": "I remember when that move was hard for you.",
      "audience": "student"
    },
    {
      "id": "master.strongMove.12",
      "category": "strongMove",
      "intensity": 1,
      "emotion": "calm",
      "text": "Good student. No, good player. You are no longer a student.",
      "audience": "student"
    },
    {
      "id": "master.strongMove.13",
      "category": "strongMove",
      "intensity": 2,
      "emotion": "happy",
      "text": "A master's move. Fischer would have nodded at that."
    },
    {
      "id": "master.comeback.1",
      "category": "comeback",
      "intensity": 1,
      "emotion": "calm",
      "text": "Patience is always rewarded. Here is the proof."
    },
    {
      "id": "master.comeback.2",
      "category": "comeback",
      "intensity": 2,
      "emotion": "confident",
      "text": "The game has turned. One tempo of opposition changes everything."
    },
    {
      "id": "master.comeback.3",
      "category": "comeback",
      "intensity": 2,
      "emotion": "happy",
      "text": "Stubborn defense, a timely counterpunch. A classic."
    },
    {
      "id": "master.comeback.4",
      "category": "comeback",
      "intensity": 3,
      "emotion": "confident",
      "text": "Remember: a won position is not a won game."
    },
    {
      "id": "master.comeback.5",
      "category": "comeback",
      "intensity": 1,
      "emotion": "focused",
      "text": "Now then. I'm back to teaching the class."
    },
    {
      "id": "master.comeback.6",
      "category": "comeback",
      "intensity": 2,
      "emotion": "calm",
      "text": "Great defenders knew: resisting gives the error its chance."
    },
    {
      "id": "master.comeback.7",
      "category": "comeback",
      "intensity": 1,
      "emotion": "calm",
      "text": "It turned. Not by magic, by patience."
    },
    {
      "id": "master.comeback.8",
      "category": "comeback",
      "intensity": 2,
      "emotion": "calm",
      "text": "It turned. This was the last lesson left: never relax.",
      "audience": "student"
    },
    {
      "id": "master.comeback.9",
      "category": "comeback",
      "intensity": 3,
      "emotion": "confident",
      "text": "The teacher still has a few cards up his sleeve.",
      "audience": "student"
    },
    {
      "id": "master.collapse.1",
      "category": "collapse",
      "intensity": 1,
      "emotion": "frustrated",
      "text": "I let it slip. My technique failed, not my chess."
    },
    {
      "id": "master.collapse.2",
      "category": "collapse",
      "intensity": 2,
      "emotion": "sad",
      "text": "Winning a won game is the hardest part. I just proved it."
    },
    {
      "id": "master.collapse.3",
      "category": "collapse",
      "intensity": 3,
      "emotion": "frustrated",
      "text": "Unforgivable. I relaxed, and endgames punish the relaxed."
    },
    {
      "id": "master.collapse.4",
      "category": "collapse",
      "intensity": 2,
      "emotion": "surprised",
      "text": "You defended well. I should have been more precise."
    },
    {
      "id": "master.collapse.5",
      "category": "collapse",
      "intensity": 1,
      "emotion": "calm",
      "text": "Steady now. The game is not over yet."
    },
    {
      "id": "master.collapse.6",
      "category": "collapse",
      "intensity": 2,
      "emotion": "calm",
      "text": "Even the greats let won endgames slip. Today, me."
    },
    {
      "id": "master.collapse.7",
      "category": "collapse",
      "intensity": 1,
      "emotion": "focused",
      "text": "I lost the thread. I must find it again, move by move."
    },
    {
      "id": "master.collapse.8",
      "category": "collapse",
      "intensity": 2,
      "emotion": "happy",
      "text": "You saved a lost position against me. What defence, my student.",
      "audience": "student"
    },
    {
      "id": "master.collapse.9",
      "category": "collapse",
      "intensity": 3,
      "emotion": "surprised",
      "text": "You learned to defend better than I taught.",
      "audience": "student"
    },
    {
      "id": "master.pieceCaptured.1",
      "category": "pieceCaptured",
      "intensity": 1,
      "emotion": "calm",
      "text": "Thank you. An extra piece, a simpler endgame."
    },
    {
      "id": "master.pieceCaptured.2",
      "category": "pieceCaptured",
      "intensity": 2,
      "emotion": "confident",
      "text": "Extra material and an active king. A known recipe."
    },
    {
      "id": "master.pieceCaptured.3",
      "category": "pieceCaptured",
      "intensity": 2,
      "emotion": "focused",
      "text": "Piece collected. Now, simplify without haste."
    },
    {
      "id": "master.pieceCaptured.4",
      "category": "pieceCaptured",
      "intensity": 3,
      "emotion": "confident",
      "text": "An undefended piece falls. True for everyone, even me."
    },
    {
      "id": "master.pieceCaptured.5",
      "category": "pieceCaptured",
      "intensity": 1,
      "emotion": "calm",
      "text": "Accepted with pleasure. Guard the next ones better."
    },
    {
      "id": "master.pieceCaptured.6",
      "category": "pieceCaptured",
      "intensity": 2,
      "emotion": "calm",
      "text": "One piece up. Trading now makes everything simpler."
    },
    {
      "id": "master.pieceCaptured.7",
      "category": "pieceCaptured",
      "intensity": 1,
      "emotion": "focused",
      "text": "Material is material. Now, technique."
    },
    {
      "id": "master.pieceCaptured.8",
      "category": "pieceCaptured",
      "intensity": 2,
      "emotion": "calm",
      "text": "A loose piece. Remember what I said at school?",
      "audience": "student"
    },
    {
      "id": "master.pieceCaptured.9",
      "category": "pieceCaptured",
      "intensity": 1,
      "emotion": "calm",
      "text": "I will take it. Consider it today's lesson.",
      "audience": "student"
    },
    {
      "id": "master.pieceLost.1",
      "category": "pieceLost",
      "intensity": 1,
      "emotion": "calm",
      "text": "One piece down. I still have my king, and he works."
    },
    {
      "id": "master.pieceLost.2",
      "category": "pieceLost",
      "intensity": 2,
      "emotion": "frustrated",
      "text": "That hurts. But regret doesn't move pieces."
    },
    {
      "id": "master.pieceLost.3",
      "category": "pieceLost",
      "intensity": 2,
      "emotion": "focused",
      "text": "Material lost. Now every tempo is gold."
    },
    {
      "id": "master.pieceLost.4",
      "category": "pieceLost",
      "intensity": 3,
      "emotion": "frustrated",
      "text": "Such carelessness. My teacher would make me redo the drill."
    },
    {
      "id": "master.pieceLost.5",
      "category": "pieceLost",
      "intensity": 1,
      "emotion": "nervous",
      "text": "Well played. I need a fortress, and quickly."
    },
    {
      "id": "master.pieceLost.6",
      "category": "pieceLost",
      "intensity": 2,
      "emotion": "calm",
      "text": "Losing material is not losing the game. Not yet."
    },
    {
      "id": "master.pieceLost.7",
      "category": "pieceLost",
      "intensity": 1,
      "emotion": "focused",
      "text": "A piece down. Now I play for a draw with dignity."
    },
    {
      "id": "master.pieceLost.8",
      "category": "pieceLost",
      "intensity": 2,
      "emotion": "happy",
      "text": "You won material from me. I did not teach that; you learned it.",
      "audience": "student"
    },
    {
      "id": "master.pieceLost.9",
      "category": "pieceLost",
      "intensity": 3,
      "emotion": "surprised",
      "text": "My student took a piece from me! I will tell this for years.",
      "audience": "student"
    },
    {
      "id": "master.ownPromotion.1",
      "category": "ownPromotion",
      "intensity": 1,
      "emotion": "calm",
      "text": "A new queen. The pawn has done its duty."
    },
    {
      "id": "master.ownPromotion.2",
      "category": "ownPromotion",
      "intensity": 2,
      "emotion": "confident",
      "text": "Passed pawns must be pushed. I've always said so."
    },
    {
      "id": "master.ownPromotion.3",
      "category": "ownPromotion",
      "intensity": 2,
      "emotion": "happy",
      "text": "Coronation. The road was paved several moves ago."
    },
    {
      "id": "master.ownPromotion.4",
      "category": "ownPromotion",
      "intensity": 3,
      "emotion": "confident",
      "text": "A fresh queen on the board. The lesson nears its end."
    },
    {
      "id": "master.ownPromotion.5",
      "category": "ownPromotion",
      "intensity": 1,
      "emotion": "calm",
      "text": "The king escorted, the pawn arrived. Teamwork."
    },
    {
      "id": "master.ownPromotion.6",
      "category": "ownPromotion",
      "intensity": 2,
      "emotion": "calm",
      "text": "Philidor called pawns the soul of chess. Here is why."
    },
    {
      "id": "master.ownPromotion.7",
      "category": "ownPromotion",
      "intensity": 1,
      "emotion": "focused",
      "text": "Nimzowitsch said: the passed pawn has a lust to expand."
    },
    {
      "id": "master.ownPromotion.8",
      "category": "ownPromotion",
      "intensity": 2,
      "emotion": "calm",
      "text": "I promoted. Remember the rule of the square? It does not forgive.",
      "audience": "student"
    },
    {
      "id": "master.opponentPromotion.1",
      "category": "opponentPromotion",
      "intensity": 1,
      "emotion": "surprised",
      "text": "A queen for you. Well escorted, I admit."
    },
    {
      "id": "master.opponentPromotion.2",
      "category": "opponentPromotion",
      "intensity": 2,
      "emotion": "nervous",
      "text": "Hm. I let that pawn walk too far."
    },
    {
      "id": "master.opponentPromotion.3",
      "category": "opponentPromotion",
      "intensity": 2,
      "emotion": "calm",
      "text": "You promoted. Now show me you can mate with her."
    },
    {
      "id": "master.opponentPromotion.4",
      "category": "opponentPromotion",
      "intensity": 3,
      "emotion": "frustrated",
      "text": "A passed pawn must never be ignored. I ignored it."
    },
    {
      "id": "master.opponentPromotion.5",
      "category": "opponentPromotion",
      "intensity": 1,
      "emotion": "focused",
      "text": "Very well. Now don't stumble into stalemate."
    },
    {
      "id": "master.opponentPromotion.6",
      "category": "opponentPromotion",
      "intensity": 2,
      "emotion": "calm",
      "text": "King in front of the pawn, as it should be. Well done."
    },
    {
      "id": "master.opponentPromotion.7",
      "category": "opponentPromotion",
      "intensity": 1,
      "emotion": "calm",
      "text": "A new queen. Now, the queen mate we practised so much.",
      "audience": "student"
    },
    {
      "id": "master.opponentPromotion.8",
      "category": "opponentPromotion",
      "intensity": 3,
      "emotion": "happy",
      "text": "You queened against me! That first school promotion paid off.",
      "audience": "student"
    },
    {
      "id": "master.opponentLowTime.1",
      "category": "opponentLowTime",
      "intensity": 1,
      "emotion": "calm",
      "text": "Your clock is low. Simple moves, please."
    },
    {
      "id": "master.opponentLowTime.2",
      "category": "opponentLowTime",
      "intensity": 2,
      "emotion": "focused",
      "text": "Little time. Now we see who knows endgames by heart."
    },
    {
      "id": "master.opponentLowTime.3",
      "category": "opponentLowTime",
      "intensity": 2,
      "emotion": "confident",
      "text": "The clock is a piece too. And yours is falling."
    },
    {
      "id": "master.opponentLowTime.4",
      "category": "opponentLowTime",
      "intensity": 3,
      "emotion": "confident",
      "text": "Tick-tock. Technique must be automatic."
    },
    {
      "id": "master.opponentLowTime.5",
      "category": "opponentLowTime",
      "intensity": 1,
      "emotion": "calm",
      "text": "Don't panic. Panic loses more games than the clock."
    },
    {
      "id": "master.opponentLowTime.6",
      "category": "opponentLowTime",
      "intensity": 2,
      "emotion": "calm",
      "text": "Short of time? Trust the patterns you already know."
    },
    {
      "id": "master.opponentLowTime.7",
      "category": "opponentLowTime",
      "intensity": 1,
      "emotion": "calm",
      "text": "Short of time, play what we practised. Your hands remember.",
      "audience": "student"
    },
    {
      "id": "master.ownLowTime.1",
      "category": "ownLowTime",
      "intensity": 1,
      "emotion": "focused",
      "text": "Little time for me. Fortunately, I know this by heart."
    },
    {
      "id": "master.ownLowTime.2",
      "category": "ownLowTime",
      "intensity": 2,
      "emotion": "nervous",
      "text": "I thought too long. An old teacher's habit."
    },
    {
      "id": "master.ownLowTime.3",
      "category": "ownLowTime",
      "intensity": 2,
      "emotion": "calm",
      "text": "In a pinch, I trust technique. It doesn't abandon me."
    },
    {
      "id": "master.ownLowTime.4",
      "category": "ownLowTime",
      "intensity": 3,
      "emotion": "nervous",
      "text": "The clock bites. Steady hands, cool head."
    },
    {
      "id": "master.ownLowTime.5",
      "category": "ownLowTime",
      "intensity": 1,
      "emotion": "calm",
      "text": "A master plays endgames in his sleep. We'll see if it's true."
    },
    {
      "id": "master.ownLowTime.6",
      "category": "ownLowTime",
      "intensity": 2,
      "emotion": "focused",
      "text": "Little time. Now I play patterns I have known for decades."
    },
    {
      "id": "master.ownLowTime.7",
      "category": "ownLowTime",
      "intensity": 2,
      "emotion": "nervous",
      "text": "My student pressing me on the clock. Who would have thought.",
      "audience": "student"
    },
    {
      "id": "master.timeAdvantage.1",
      "category": "timeAdvantage",
      "intensity": 1,
      "emotion": "calm",
      "text": "I have time to spare. I will use it to think well."
    },
    {
      "id": "master.timeAdvantage.2",
      "category": "timeAdvantage",
      "intensity": 2,
      "emotion": "confident",
      "text": "No hurry. Each move of mine drains your clock a bit."
    },
    {
      "id": "master.timeAdvantage.3",
      "category": "timeAdvantage",
      "intensity": 2,
      "emotion": "focused",
      "text": "I'll maneuver calmly. You're the one who must decide."
    },
    {
      "id": "master.timeAdvantage.4",
      "category": "timeAdvantage",
      "intensity": 3,
      "emotion": "confident",
      "text": "Clock and position on my side. Double pressure."
    },
    {
      "id": "master.timeAdvantage.5",
      "category": "timeAdvantage",
      "intensity": 1,
      "emotion": "playful",
      "text": "One more king stroll. Just to admire the view."
    },
    {
      "id": "master.timeAdvantage.6",
      "category": "timeAdvantage",
      "intensity": 2,
      "emotion": "calm",
      "text": "Time to spare. Use yours too: think about plans."
    },
    {
      "id": "master.timeAdvantage.7",
      "category": "timeAdvantage",
      "intensity": 1,
      "emotion": "calm",
      "text": "Remember: at school the clock did not run. Here it does.",
      "audience": "student"
    },
    {
      "id": "master.opponentThinking.1",
      "category": "opponentThinking",
      "intensity": 1,
      "emotion": "calm",
      "text": "Take your time. But remember: plan first, move second."
    },
    {
      "id": "master.opponentThinking.2",
      "category": "opponentThinking",
      "intensity": 2,
      "emotion": "focused",
      "text": "A useful question: where should your king be?"
    },
    {
      "id": "master.opponentThinking.3",
      "category": "opponentThinking",
      "intensity": 1,
      "emotion": "calm",
      "text": "Counting squares helps. The rule of the square, for one."
    },
    {
      "id": "master.opponentThinking.4",
      "category": "opponentThinking",
      "intensity": 2,
      "emotion": "playful",
      "text": "Take all the time you need. I'll wait, hands behind my back."
    },
    {
      "id": "master.opponentThinking.5",
      "category": "opponentThinking",
      "intensity": 3,
      "emotion": "focused",
      "text": "Overthinking a simple position wastes the clock."
    },
    {
      "id": "master.opponentThinking.6",
      "category": "opponentThinking",
      "intensity": 1,
      "emotion": "calm",
      "text": "Silence. That's how good moves are born."
    },
    {
      "id": "master.opponentThinking.7",
      "category": "opponentThinking",
      "intensity": 2,
      "emotion": "calm",
      "text": "Morphy said: help your pieces so they can help you."
    },
    {
      "id": "master.opponentThinking.8",
      "category": "opponentThinking",
      "intensity": 1,
      "emotion": "calm",
      "text": "Thinking? Good. But trust what you already know."
    },
    {
      "id": "master.opponentThinking.9",
      "category": "opponentThinking",
      "intensity": 1,
      "emotion": "happy",
      "text": "I know that look of concentration from school.",
      "audience": "student"
    },
    {
      "id": "master.opponentThinking.10",
      "category": "opponentThinking",
      "intensity": 2,
      "emotion": "calm",
      "text": "Think as I taught you: king, pawns, then the pieces.",
      "audience": "student"
    },
    {
      "id": "master.opponentThinking.11",
      "category": "opponentThinking",
      "intensity": 1,
      "emotion": "calm",
      "text": "Take your time. Botvinnik prepared everything, even his rest."
    },
    {
      "id": "master.win.1",
      "category": "win",
      "intensity": 1,
      "emotion": "calm",
      "text": "Good game. Study this ending; it will return."
    },
    {
      "id": "master.win.2",
      "category": "win",
      "intensity": 2,
      "emotion": "happy",
      "text": "I won, but you made me work. That's a compliment."
    },
    {
      "id": "master.win.3",
      "category": "win",
      "intensity": 2,
      "emotion": "calm",
      "text": "Today's lesson: active king, passed pawn, patience."
    },
    {
      "id": "master.win.4",
      "category": "win",
      "intensity": 3,
      "emotion": "confident",
      "text": "Clean technique, start to finish. That's how endings are played."
    },
    {
      "id": "master.win.5",
      "category": "win",
      "intensity": 1,
      "emotion": "calm",
      "text": "Shake my hand. Next time, more opposition."
    },
    {
      "id": "master.win.6",
      "category": "win",
      "intensity": 2,
      "emotion": "calm",
      "text": "Every loss to a master is a free lesson. Make use of it."
    },
    {
      "id": "master.win.7",
      "category": "win",
      "intensity": 1,
      "emotion": "happy",
      "text": "Thank you for the game. Come back anytime; my door is open."
    },
    {
      "id": "master.win.8",
      "category": "win",
      "intensity": 2,
      "emotion": "calm",
      "text": "I won today. But a student who loses and returns wins one day.",
      "audience": "student"
    },
    {
      "id": "master.win.9",
      "category": "win",
      "intensity": 3,
      "emotion": "happy",
      "text": "I won, but what a game! I am proud of you.",
      "audience": "student"
    },
    {
      "id": "master.win.10",
      "category": "win",
      "intensity": 1,
      "emotion": "calm",
      "text": "Not yet, my student. But you are very close.",
      "audience": "student"
    },
    {
      "id": "master.win.11",
      "category": "win",
      "intensity": 2,
      "emotion": "calm",
      "text": "Visit the school now and then. Masters review too.",
      "audience": "student"
    },
    {
      "id": "master.win.12",
      "category": "win",
      "intensity": 2,
      "emotion": "calm",
      "text": "I dedicate every win to my first teacher, at a small club."
    },
    {
      "id": "master.loss.1",
      "category": "loss",
      "intensity": 1,
      "emotion": "calm",
      "text": "Congratulations. You played better. I shake your hand."
    },
    {
      "id": "master.loss.2",
      "category": "loss",
      "intensity": 2,
      "emotion": "surprised",
      "text": "You beat the master. Keep this game."
    },
    {
      "id": "master.loss.3",
      "category": "loss",
      "intensity": 2,
      "emotion": "sad",
      "text": "I lost. Back to my books, like any good student."
    },
    {
      "id": "master.loss.4",
      "category": "loss",
      "intensity": 3,
      "emotion": "happy",
      "text": "Bravo! I would sign my name under that technique."
    },
    {
      "id": "master.loss.5",
      "category": "loss",
      "intensity": 1,
      "emotion": "frustrated",
      "text": "Hm. I straighten my tie and accept it. Well played."
    },
    {
      "id": "master.loss.6",
      "category": "loss",
      "intensity": 2,
      "emotion": "happy",
      "text": "Losing to someone who plays well is a privilege. Thank you."
    },
    {
      "id": "master.loss.7",
      "category": "loss",
      "intensity": 1,
      "emotion": "calm",
      "text": "Chess is bigger than both of us. Today it chose you."
    },
    {
      "id": "master.loss.8",
      "category": "loss",
      "intensity": 3,
      "emotion": "happy",
      "text": "The student beat the teacher. The most beautiful thing in chess.",
      "audience": "student"
    },
    {
      "id": "master.loss.9",
      "category": "loss",
      "intensity": 2,
      "emotion": "happy",
      "text": "Remember the rook collecting stars? Look where you are now.",
      "audience": "student"
    },
    {
      "id": "master.loss.10",
      "category": "loss",
      "intensity": 3,
      "emotion": "sad",
      "text": "I lost, and I was never so glad to lose. Thank you, my student.",
      "audience": "student"
    },
    {
      "id": "master.loss.11",
      "category": "loss",
      "intensity": 2,
      "emotion": "calm",
      "text": "My teacher said the student must surpass the master. You did.",
      "audience": "student"
    },
    {
      "id": "master.loss.12",
      "category": "loss",
      "intensity": 1,
      "emotion": "happy",
      "text": "Now you will teach someone. Promise me you will.",
      "audience": "student"
    },
    {
      "id": "master.loss.13",
      "category": "loss",
      "intensity": 2,
      "emotion": "calm",
      "text": "One day someone will learn from you. That is how chess lives on."
    },
    {
      "id": "master.draw.1",
      "category": "draw",
      "intensity": 1,
      "emotion": "calm",
      "text": "A draw. Fair, given how we both played."
    },
    {
      "id": "master.draw.2",
      "category": "draw",
      "intensity": 2,
      "emotion": "focused",
      "text": "Stalemate. A classic. Always check the king's squares."
    },
    {
      "id": "master.draw.3",
      "category": "draw",
      "intensity": 2,
      "emotion": "calm",
      "text": "Repetition. Neither of us found anything more."
    },
    {
      "id": "master.draw.4",
      "category": "draw",
      "intensity": 3,
      "emotion": "frustrated",
      "text": "Half a point. I expected more of myself."
    },
