      "category": "better",
      "intensity": 1,
      "emotion": "focused",
      "text": "Massa boa. Só precisa de mais um tempinho no forno."
    },
    {
      "id": "foodie.better.3",
      "category": "better",
      "intensity": 2,
      "emotion": "happy",
      "text": "Gostei desse tempero. Vou caprichar."
