      "category": "gameStart",
      "intensity": 1,
      "emotion": "calm",
      "text": "Deixa eu limpar os dedos antes de mexer nas peças."
    },
    {
      "id": "foodie.bigAdvantage.1",
      "category": "bigAdvantage",
      "intensity": 1,
      "emotion": "calm",
      "text": "Essa posição tá no ponto. Só falta tirar do forno."
