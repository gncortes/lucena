      "category": "better",
      "intensity": 3,
      "emotion": "confident",
      "text": "Sem pressa. Fogo baixo é que dá sabor."
    },
    {
      "id": "foodie.equal.1",
      "category": "equal",
      "intensity": 1,
      "emotion": "calm",
      "text": "Meio a meio, igual pizza de dois sabores."
