{
  "character": "foodie",
  "language": "pt",
  "lines": [
    {
      "id": "foodie.gameStart.1",
      "category": "gameStart",
      "intensity": 1,
      "emotion": "calm",
      "text": "Pode sentar. Eu jogo e como, as duas coisas sem pressa."
    },
    {
      "id": "foodie.gameStart.2",
      "category": "gameStart",
      "intensity": 1,
      "emotion": "happy",
      "text": "Pizza quentinha, final no tabuleiro. Dia bom."
    },
    {
