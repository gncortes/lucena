      "category": "gameStart",
      "intensity": 2,
      "emotion": "confident",
      "text": "Final é igual massa: tem que ter paciência pra crescer."
    },
    {
      "id": "foodie.gameStart.5",
      "category": "gameStart",
      "intensity": 3,
      "emotion": "confident",
      "text": "Relaxa. Eu sirvo devagar, mas sempre sirvo tudo."
