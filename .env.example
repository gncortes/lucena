# Copie para .env e ajuste à sua máquina. O .env não sobe para o repositório.

# Caminho do SDK do Flutter (se `flutter` não estiver no PATH)
FLUTTER_ROOT=

# AVD usado para rodar o app e a suíte Patrol (`emulator -list-avds`)
ANDROID_AVD=

# Serial do aparelho/emulador (`adb devices`), usado em `flutter run -d` e `patrol test -d`
ANDROID_DEVICE=emulator-5554
