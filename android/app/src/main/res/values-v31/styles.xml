<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- H-ANI-43: no Android 12+, a tela do sistema mostra o peão do ícone crescendo
         no fundo escuro (500 ms) e o Flutter segue da mesma pose (H-ANI-44). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#14211B</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/abertura_peao</item>
        <item name="android:windowSplashScreenAnimationDuration">500</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
